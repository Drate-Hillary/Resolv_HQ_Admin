# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the resolv-hq-backend service. All data access goes through it —
# this app only uses Supabase directly for auth (sign-in, session refresh).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
