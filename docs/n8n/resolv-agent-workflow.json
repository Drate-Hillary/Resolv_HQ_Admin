        ],
        [
          {
            "node": "Record result: answered",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Human approval gate": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
